#!/bin/sh
# Blocks any commit that contains something that looks like a secret (CLAUDE.md rule 8, A13).
# Enable once per clone: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed; refusing to commit. Install it with: brew install gitleaks" >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner
