<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Scribe Bot auto-deploy (2026-11-25): every 5 minutes, deploy main if GitHub has a newer commit (scripts/auto_deploy.sh).
     Installed by scripts/setup/m14_auto_deploy.sh with __HOME__ replaced by the home folder. Runs at low priority. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scribebot.autodeploy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/scribe-bot/scripts/auto_deploy.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/scribe-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCRIBE_BOT_DATA</key><string>__HOME__/scribe-bot-data</string>
    <key>PATH</key><string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/scribe-bot-data/logs/auto-deploy.stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/scribe-bot-data/logs/auto-deploy.stderr.log</string>
</dict>
</plist>
