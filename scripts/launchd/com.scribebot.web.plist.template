<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Scribe Bot web app (FastAPI). Installed into ~/Library/LaunchAgents on the M14 with __HOME__ replaced.
     Entry point scribe_bot.web arrives in M4; which address it listens on (Tailscale only) is decided then. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scribebot.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/uv</string>
    <string>run</string>
    <string>--project</string><string>__HOME__/scribe-bot</string>
    <string>python</string><string>-m</string><string>scribe_bot.web</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/scribe-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCRIBE_BOT_DATA</key><string>__HOME__/scribe-bot-data</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/scribe-bot-data/logs/web.stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/scribe-bot-data/logs/web.stderr.log</string>
</dict>
</plist>
