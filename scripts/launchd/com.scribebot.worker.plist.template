<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Scribe Bot job worker (queue + scheduler). Installed into ~/Library/LaunchAgents on the M14 with
     __HOME__ replaced by the home folder. A LaunchAgent runs in the logged-in session, so it can read the Keychain.
     Entry point scribe_bot.worker arrives later in M1. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.scribebot.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/uv</string>
    <string>run</string>
    <string>--project</string><string>__HOME__/scribe-bot</string>
    <string>python</string><string>-m</string><string>scribe_bot.worker</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/scribe-bot</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SCRIBE_BOT_DATA</key><string>__HOME__/scribe-bot-data</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__HOME__/scribe-bot-data/logs/worker.stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/scribe-bot-data/logs/worker.stderr.log</string>
</dict>
</plist>
